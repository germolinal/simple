---
// A house under the sun
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <rect width="64" height="64" rx="14" fill="#164e63"></rect>
  <circle cx="45" cy="19" r="7" fill="#fbbf24"></circle>
  <g stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round">
    <path
      d="M45 6.5v3M45 28.5v3M32.5 19h3M54.5 19h3M36.2 10.2l2.1 2.1M51.7 25.7l2.1 2.1M36.2 27.8l2.1-2.1M51.7 12.3l2.1-2.1"
    ></path>
  </g>
  <path d="M12 50V31L28 18l16 13v19z" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round"></path>
  <path d="M23 50V39h10v11" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round"></path>
  <path d="M8 50h48" stroke="#22d3ee" stroke-width="4" stroke-linecap="round"></path>
</svg>
