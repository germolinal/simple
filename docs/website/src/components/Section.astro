---
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-16 border-t border-line py-14">
  <div class="mx-auto max-w-5xl px-4 sm:px-5">
    <h2 class="mb-2 text-3xl font-bold tracking-tight">{title}</h2>
    {intro && <p class="mb-8 max-w-3xl text-lg text-muted">{intro}</p>}
    <slot />
  </div>
</section>
